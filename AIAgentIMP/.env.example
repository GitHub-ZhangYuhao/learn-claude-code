# ============================================================================
#  AgentTeam 配置文件
#  复制此文件为 .env 并填写实际值
# ============================================================================

# ── LLM 配置（本地客户端需要）──────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-4o

# ── Slack Bot Relay 服务器配置（仅 Relay 机器需要）─────────────────────
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SOCKET_TOKEN=xapp-xxx
WS_HOST=0.0.0.0
WS_PORT=8765

# ── 本地 Agent 客户端配置（每个同事本地需要）──────────────────────────
# Slack 用户 ID（获取方式: Slack 个人资料 → 更多 → 复制成员 ID）
SLACK_USER_ID=U0123456789
# Relay 服务器 WebSocket 地址（替换为 Relay 机器的内网 IP）
WS_SERVER_URL=ws://10.251.138.61:8765
