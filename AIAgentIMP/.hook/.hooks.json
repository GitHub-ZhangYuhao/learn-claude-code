{
  "hooks": {
    "SessionStart": [
      {
        "command": "python .hook/on_session_start.py",
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "command": "python .hook/safety_check.py",
        "matcher": "bash"
      },
      {
        "command": "python .hook/log_tool.py",
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "command": "python .hook/log_result.py",
        "matcher": "*"
      }
    ]
  }
}
